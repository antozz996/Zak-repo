# Zak Ecosystem AI - environment template
# Copy this file to .env locally or create the same keys in your hosting panel.
# Never commit real secrets.

# Required backend runtime
PORT=3000
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
ZAK_AUTH_SECRET=replace-with-a-long-random-secret
ZAK_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-random-bootstrap-token

# Optional LLM Booking Assistant
ZAK_LLM_BOOKING_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ZAK_LLM_BOOKING_MODEL=gpt-5.4-nano
ZAK_LLM_BOOKING_TIMEOUT_MS=12000

# Optional Google Calendar
ZAK_GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Rome
GOOGLE_CHANNEL_TOKEN=
ZAK_GOOGLE_DELETE_CANCELLED=false

# Optional Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v20.0
META_WHATSAPP_TEMPLATE_LANGUAGE=it
META_WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
META_WHATSAPP_RICORRENZA_TEMPLATE_NAME=

# Optional Voice Assistant providers
VOICE_WEBHOOK_SECRET=
VAPI_WEBHOOK_SECRET=
BLAND_WEBHOOK_SECRET=
